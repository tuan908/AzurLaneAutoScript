{
  "name": "alas-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "typecheck": "node ./node_modules/typescript-check/bin/tsc --noEmit",
    "gen:api": "openapi-typescript openapi.json --output src/api/generated.ts",
    "test": "vitest run",
    "lint": "oxlint src",
    "test:e2e": "playwright test e2e",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fmt": "oxfmt",
    "check": "oxlint src && oxfmt --check && bun run typecheck"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "3.14.28",
    "@ui-sdk/core": "^0.1.0-beta.17",
    "@ui-sdk/react": "^0.1.0-beta.17",
    "class-variance-authority": "^0.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@playwright/test": "1.65.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@types/node": "^26.6.10",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6",
    "babel-plugin-react-compiler": "^1.0.0",
    "openapi-typescript": "7.10.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "5.9.3",
    "typescript-check": "npm:typescript@7.0.2",
    "vite": "8",
    "vitest": "4"
  }
}
