{
  "name": "alas-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript openapi.json --output src/api.generated.ts",
    "test": "vitest run",
    "test:e2e": "playwright test e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-virtual": "3.14.28",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
